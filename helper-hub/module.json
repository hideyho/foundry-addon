{
  "id": "helper-hub",
  "title": "Helper Hub",
  "description": "Scene transitions (TV static, smoke, spinner, cinematic whip, and a custom animation) plus images and YouTube in chat and playlists.",
  "version": "1.0.3",
  "url": "https://github.com/hideyho/foundry-addon",
  "manifest": "https://github.com/hideyho/foundry-addon/releases/latest/download/module.json",
  "download": "https://github.com/hideyho/foundry-addon/releases/download/v1.0.3/module.zip",
  "bugs": "https://github.com/hideyho/foundry-addon/issues",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": ["scripts/module.mjs"],
  "styles": [{ "src": "styles/helper-hub.css", "layer": "modules" }],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "ru", "name": "Русский", "path": "lang/ru.json" }
  ],
  "persistentStorage": true,
  "relationships": {
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module",
        "manifest": "https://github.com/ruipin/fvtt-lib-wrapper/releases/latest/download/module.json"
      }
    ]
  }
}
